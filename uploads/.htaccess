# Prevent execution of any script in the uploads directory,
# even if a malicious file ever got past upload validation.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar|cgi|pl)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
