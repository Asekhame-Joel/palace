# Prevent execution of any script in the uploads directory,
# even if a malicious file ever got past upload validation.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar|cgi|pl)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI

# Ensure shared hosting serves uploaded media with browser-playable MIME types.
<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogv .ogg
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(mp4|webm|ogv|ogg)$">
        Header set Accept-Ranges "bytes"
    </FilesMatch>
</IfModule>
